{
  "info": {
    "_postman_id": "c923b44b-66a4-4bfc-a95e-f4f9010e6f5a",
    "name": "OAN Grievance - Development Agent",
    "description": "Development Agent signs in through Keycloak (agent realm) via IAM and raises a grievance on behalf of a citizen. The flow covers: DA authentication, raising a walk-in grievance, posting timeline messages/updates, officer login and resolution, DA reopening the case on behalf of citizen, officer resolving again, DA closing the case with satisfaction rating, timeline verification, and cleanup logouts for both officer and agent sessions. Runs end-to-end after the E2E runner (or standalone with pre-configured officer/categories).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "K1. Start Keycloak login (agent realm via IAM)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/v1/auth/iam/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "auth",
            "iam",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"key\": \"{{keycloak_login_key}}\",\n  \"provider\": \"{{keycloak_login_key}}\",\n  \"return_url\": \"{{base_url}}\"\n}"
        },
        "description": "Initiates OAuth2 login transaction via OpenG2P IAM for Development Agent."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get(\"keycloak_login_key\")) { pm.collectionVariables.set(\"keycloak_login_key\", pm.environment.get(\"keycloak_login_key\") || \"agent\"); }",
              "if (!pm.collectionVariables.get(\"iam_provider\")) {",
              "    pm.collectionVariables.set(\"iam_provider\", pm.environment.get(\"iam_provider\") || \"agent\");",
              "}",
              "if (!pm.collectionVariables.get(\"iam_user\")) {",
              "    pm.collectionVariables.set(\"iam_user\", pm.environment.get(\"iam_user\") || \"da-agent@services.com\");",
              "}",
              "if (!pm.collectionVariables.get(\"iam_password\")) {",
              "    pm.collectionVariables.set(\"iam_password\", pm.environment.get(\"iam_password\"));",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () {",
              "    if (pm.response.code !== 200) { console.error(pm.response.text()); }",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "var data = jsonData.data || jsonData;",
              "pm.test(\"redirect_url returned\", function () {",
              "    pm.expect(data).to.have.property(\"redirect_url\");",
              "});",
              "if (data && data.redirect_url) {",
              "    pm.collectionVariables.set(\"authorization_url\", data.redirect_url);",
              "    console.log(\"[K1] Authorization URL:\", data.redirect_url);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "K2. Open Keycloak login form",
      "protocolProfileBehavior": {
        "followRedirects": true
      },
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{authorization_url}}",
          "host": [
            "{{authorization_url}}"
          ]
        },
        "description": "Fetches Keycloak login HTML page and extracts form action URL (mimics browser step)."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var token = pm.collectionVariables.get(\"keycloak_access_token\") || pm.environment.get(\"keycloak_access_token\");",
              "var authUrl = pm.collectionVariables.get(\"authorization_url\");",
              "if (token || !authUrl) { pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () {",
              "    if (pm.response.code !== 200) { console.error(pm.response.text()); }",
              "    pm.response.to.have.status(200);",
              "});",
              "var html = pm.response.text();",
              "var formMatch = html.match(/<form\\b[^>]*\\bid=[\"']kc-form-login[\"'][^>]*action=[\"']([^\"']+)[\"']/i);",
              "if (!formMatch) { formMatch = html.match(/action=[\"']([^\"']+)[\"']/i); }",
              "pm.test(\"Keycloak login form present\", function () {",
              "    pm.expect(formMatch).to.not.be.null;",
              "});",
              "if (formMatch) {",
              "    var actionUrl = formMatch[1].replace(/&amp;/g, \"&\");",
              "    pm.collectionVariables.set(\"kc_login_action\", actionUrl);",
              "    console.log(\"[K2] Keycloak login action:\", actionUrl);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "K3. Sign in Development Agent (Keycloak)",
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "url": {
          "raw": "{{kc_login_action}}",
          "host": [
            "{{kc_login_action}}"
          ]
        },
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "username",
              "value": "{{iam_user}}",
              "type": "text"
            },
            {
              "key": "password",
              "value": "{{iam_password}}",
              "type": "text"
            },
            {
              "key": "credentialId",
              "value": "",
              "type": "text"
            }
          ]
        },
        "description": "Posts credentials to Keycloak login form and captures 302 redirect location to IAM callback."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var token = pm.collectionVariables.get(\"keycloak_access_token\") || pm.environment.get(\"keycloak_access_token\");",
              "var actionUrl = pm.collectionVariables.get(\"kc_login_action\");",
              "if (token || !actionUrl) { pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Keycloak redirects with authorization code (302/303)\", function () {",
              "    pm.expect([302, 303]).to.include(pm.response.code);",
              "});",
              "var location = pm.response.headers.get(\"Location\") || \"\";",
              "pm.test(\"Callback location present\", function () {",
              "    pm.expect(location).to.not.be.empty;",
              "});",
              "if (location) {",
              "    pm.collectionVariables.set(\"iam_callback_url\", location);",
              "    console.log(\"[K3] IAM callback URL:\", location);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "K4. Complete IAM callback and retain access token",
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{iam_callback_url}}",
          "host": [
            "{{iam_callback_url}}"
          ]
        },
        "description": "Calls IAM callback to complete code exchange and extracts X-Access-Token cookie."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var token = pm.collectionVariables.get(\"keycloak_access_token\") || pm.environment.get(\"keycloak_access_token\");",
              "var cbUrl = pm.collectionVariables.get(\"iam_callback_url\");",
              "if (token || !cbUrl) { pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"IAM callback redirects after exchange (302/303/307)\", function () {",
              "    pm.expect([302, 303, 307]).to.include(pm.response.code);",
              "});",
              "var cookieHeaders = pm.response.headers.all().filter(function (h) {",
              "    return h.key.toLowerCase() === \"set-cookie\";",
              "});",
              "var tokens = cookieHeaders.map(function (h) {",
              "    var match = h.value.match(/^X-Access-Token=([^;]*)/i);",
              "    return match ? match[1].replace(/^\"|\"$/g, \"\") : null;",
              "}).filter(Boolean);",
              "var token = tokens[tokens.length - 1];",
              "pm.test(\"IAM issued access token\", function () {",
              "    pm.expect(token).to.be.a(\"string\").and.not.empty;",
              "});",
              "if (token) {",
              "    pm.collectionVariables.set(\"keycloak_access_token\", token);",
              "    console.log(\"[K4] Acquired keycloak_access_token from IAM cookie\");",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "K5. Who am I (verifies Development Agent token)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/v1/auth/me",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "auth",
            "me"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{keycloak_access_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
              "var d = pm.response.json().data || {};",
              "pm.test(\"Has Grievance Assisted Submitter role\", function () { pm.expect(JSON.stringify(d)).to.include(\"Grievance Assisted Submitter\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "K6. Raise grievance on behalf of a citizen (walk-in)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/v1/grievances",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "grievances"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"client_submission_uuid\": \"{{keycloak_client_uuid}}\",\n  \"submission_channel\": \"Development Agent Assisted\",\n  \"submitter_type\": \"Individual Farmer\",\n  \"submitter_name\": \"Agent Walk-in Farmer\",\n  \"contact_mobile\": \"{{contact_mobile}}\",\n  \"administrative_area\": \"{{administrative_area}}\",\n  \"administrative_unit\": \"{{administrative_unit}}\",\n  \"service_category\": \"{{taxonomy_category}}\",\n  \"grievance_type\": \"{{taxonomy_grievance_type}}\",\n  \"description\": \"Raised by a Development Agent on behalf of a farmer: fertilizer voucher never arrived.\",\n  \"desired_outcome\": \"Reissue the fertilizer voucher.\",\n  \"is_anonymous\": 0,\n  \"consent_given\": 1\n}"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{keycloak_access_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var uuid = (typeof crypto !== \"undefined\" && crypto.randomUUID) ? crypto.randomUUID() : (Date.now().toString(36) + Math.random().toString(36));",
              "pm.collectionVariables.set(\"keycloak_client_uuid\", uuid);",
              "var cat = pm.collectionVariables.get(\"taxonomy_category\");",
              "var type = pm.collectionVariables.get(\"taxonomy_grievance_type\");",
              "pm.collectionVariables.set(\"taxonomy_category\", \"Market & Price\");",
              "pm.collectionVariables.set(\"taxonomy_grievance_type\", \"Market Access Obstruction\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () {",
              "    if (pm.response.code !== 200) { console.error(pm.response.text()); }",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "var d = jsonData.data || jsonData;",
              "pm.test(\"Ticket issued\", function () { pm.expect(d).to.have.property(\"ticket_number\"); });",
              "if (d.ticket_number) {",
              "    pm.collectionVariables.set(\"ticket_number\", d.ticket_number);",
              "    pm.environment.set(\"ticket_number\", d.ticket_number);",
              "    console.log(\"[K3] Ticket issued:\", d.ticket_number);",
              "}"
            ]
          }
        }
      ]
    },
    {
