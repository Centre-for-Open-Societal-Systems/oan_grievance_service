{
  "groups": [
    {
      "name": "grievance-placement",
      "displayHeader": "Grievance placement",
      "displayDescription": "Where the officer sits in the grievance service. Read at every sign-in."
    }
  ],
  "attributes": [
    {
      "name": "grievance_level",
      "displayName": "Grievance level",
      "group": "grievance-placement",
      "multivalued": false,
      "validations": {
        "options": { "options": ["L1", "L2", "L3", "reviewer"] }
      },
      "annotations": { "inputType": "select" },
      "permissions": { "view": ["admin"], "edit": ["admin"] }
    },
    {
      "name": "grievance_categories",
      "displayName": "Grievance service categories",
      "group": "grievance-placement",
      "multivalued": true,
      "validations": {
        "length": { "min": 1, "max": 140 }
      },
      "permissions": { "view": ["admin"], "edit": ["admin"] }
    },
    {
      "name": "grievance_department",
      "displayName": "Grievance department (optional)",
      "group": "grievance-placement",
      "multivalued": false,
      "validations": {
        "length": { "min": 1, "max": 140 }
      },
      "permissions": { "view": ["admin"], "edit": ["admin"] }
    },
    {
      "name": "grievance_region",
      "displayName": "Grievance region (optional)",
      "group": "grievance-placement",
      "multivalued": false,
      "validations": {
        "length": { "min": 1, "max": 140 }
      },
      "permissions": { "view": ["admin"], "edit": ["admin"] }
    }
  ]
}
