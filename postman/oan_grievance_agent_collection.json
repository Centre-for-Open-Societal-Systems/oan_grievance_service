      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/v1/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usr\": \"{{officer_email}}\",\n  \"pwd\": \"{{keycloak_officer_password}}\"\n}"
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"officer_email\", \"officer@mrkt.co\");",
              "if (!pm.collectionVariables.get(\"officer_new_password\")) {",
              "    pm.collectionVariables.set(\"officer_new_password\", pm.environment.get(\"officer_new_password\") || \"OfficerPass#2026\");",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    if (pm.response.code !== 200) { console.error(pm.response.text()); }",
              "    pm.response.to.have.status(200);",
              "});",
              "var body = pm.response.json();",
              "var data = body.data || body;",
              "if (data && data.access_token) {",
              "    pm.collectionVariables.set(\"officer_access_token\", data.access_token);",
              "}",
              "if (data && data.refresh_token) {",
              "    pm.collectionVariables.set(\"officer_refresh_token\", data.refresh_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "K10. Resolve Grievance (Officer)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/v1/grievances/{{ticket_number}}/action",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "grievances",
            "{{ticket_number}}",
            "action"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"Resolve\",\n  \"action_taken\": \"Replacement fertilizer voucher issued at the Woreda desk.\",\n  \"resolution_summary\": \"Voucher reissued; case resolved pending citizen confirmation.\"\n}"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{officer_access_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"access_token\", pm.collectionVariables.get(\"officer_access_token\"));",
              "function getState() {",
              "    return new Promise((resolve) => {",
              "        var ticket = pm.collectionVariables.get(\"ticket_number\") || pm.environment.get(\"ticket_number\");",
              "        var token = pm.collectionVariables.get(\"officer_access_token\") || pm.environment.get(\"officer_access_token\");",
              "        if (!ticket || !token) return resolve(null);",
              "        pm.sendRequest({",
              "            url: pm.variables.get(\"base_url\") + \"/v1/grievances/\" + ticket + \"/timeline\",",
              "            method: \"GET\",",
              "            header: { Authorization: \"Bearer \" + token },",
              "        }, (err, res) => {",
              "            if (err) return resolve(null);",
              "            try {",
              "                var json = res.json();",
              "                var data = json.data || json;",
              "                var state = (data.current_state && data.current_state.status) || data.status;",
              "                resolve(state);",
              "            } catch (e) { resolve(null); }",
              "        });",
              "    });",
              "}",
              "(async () => {",
              "    var tries = 0, state = null;",
              "    while (tries < 15) {",
              "        state = await getState();",
              "        if (state === \"Assigned\" || state === \"In Progress\") break;",
              "        await new Promise((r) => setTimeout(r, 1000));",
              "        tries++;",
              "    }",
              "    console.log(\"[K10] grievance state before resolve:\", state);",
              "})();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    if (pm.response.code !== 200) { console.error(pm.response.text()); }",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "var data = jsonData.data || jsonData;",
              "pm.test(\"Grievance marked Resolved\", function () { pm.expect(data.status).to.eql(\"Resolved\"); });"
            ]
          }
        }
      ]
    },
