digraph ComponentArchitecture {
  compound=true;
  rankdir=TB;
  bgcolor="white";
  splines=spline;
  nodesep=0.45;
  ranksep=0.90;
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#495057",
        fontname="Helvetica", fontsize=11, margin="0.18,0.10"];
  edge [fontname="Helvetica", fontsize=9, color="#495057", fontcolor="#343a40"];

  A   [label="Farmer / Field Agent"];
  C   [label="Case Officers & Admins"];
  B   [label="Mobile App"];
  IVR [label="IVR Service"];
  J   [label="Mail Service"];
  TG  [label="Telegram Bot Service"];
  F   [label="Grievance Web Application"];
  GW  [label="API Gateway (Kong)", fillcolor="#fff3cd", color="#d39e00", penwidth=2];

  subgraph cluster_grievance_service {
    label="Grievance Service";
    fontname="Helvetica-Bold";
    fontsize=13;
    fontcolor="#1971c2";
    style="rounded,dashed";
    color="#4dabf7";
    penwidth=1.5;
    bgcolor="#f8faff";
    margin=24;
    labelloc="b";
    labeljust="c";

    H [label="SLA Automation Engine"];
    I [label="Notification Gateway"];

    { rank=same; H; I; }
  }

  { rank=same; A; C; }
  { rank=same; B; IVR; J; TG; F; }

  A -> B   [label="Submit / Track"];
  A -> IVR [label="Call / SMS"];
  A -> J   [label="Email"];
  A -> TG  [label="Chat"];
  A -> F   [label="Submit / Track"];
  C -> F   [label="Triage / Resolve"];

  B   -> GW [label="Submit / Track", dir=both];
  IVR -> GW [label="SMS channel"];
  J   -> GW [label="Get ticket"];
  TG  -> GW [label="Submit / Track", dir=both];
  F   -> GW [label="Access by role", dir=both];

  GW -> H [lhead=cluster_grievance_service, label="Grievance API", dir=both];
}
