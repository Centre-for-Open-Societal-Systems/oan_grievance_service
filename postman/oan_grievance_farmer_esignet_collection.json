    {
      "name": "4. Grievances (farmer's own cases)",
      "item": [
        {
          "name": "4b. Submit grievance",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{farmer_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/grievances",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "grievances"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_submission_uuid\": \"{{client_uuid}}\",\n  \"submission_channel\": \"Web Portal\",\n  \"submitter_type\": \"Individual Farmer\",\n  \"submitter_name\": \"{{farmer_name}}\",\n  \"contact_mobile\": \"{{farmer_phone}}\",\n  \"administrative_area\": \"{{administrative_area}}\",\n  \"administrative_unit\": \"{{administrative_unit}}\",\n  \"service_category\": \"{{service_category}}\",\n  \"grievance_type\": \"{{grievance_type}}\",\n  \"description\": \"Newman run: fertilizer voucher never arrived for this cycle.\",\n  \"desired_outcome\": \"Reissue the fertilizer voucher.\",\n  \"is_anonymous\": 0,\n  \"consent_given\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('client_uuid', require('uuid').v4());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is one of 200/201', function () { pm.expect([200, 201]).to.include(pm.response.code); });",
                  "var d = (pm.response.json() || {}).data || {};",
                  "pm.test('ticket number issued', function () { pm.expect(d.ticket_number).to.be.ok; });",
                  "pm.environment.set('ticket_number', d.ticket_number);"
                ]
              }
            }
          ]
        },
        {
          "name": "4c. List my grievances",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{farmer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/grievances?page=1&page_size=20&sort_order=desc",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "grievances"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "20"
                },
                {
                  "key": "sort_order",
                  "value": "desc"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
